      "id": "0f853df4-9579-4ae9-8901-56b7493c82f1",
      "name": "Get Products",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const norm = s => String(s || '').toLocaleLowerCase('tr')\n  .replace(/ö/g,'o').replace(/ü/g,'u').replace(/ş/g,'s')\n  .replace(/ç/g,'c').replace(/ğ/g,'g').replace(/ı/g,'i').trim();\n\nconst parsed = $('Code in JavaScript1').first().json;\nconst products = $input.all().map(i => i.json);\n\nconst stock = {};\nproducts.forEach(p => { stock[p.sku] = Number(p.stock); });\n\nconst find = name => {\n  const n = norm(name);\n  if (!n) return null;\n  return products.find(p => {\n    const pn = norm(p.product_name);\n    return n === pn || n.includes(pn) || pn.includes(n);\n  }) || null;\n};\n\nconst lines = [];\nconst moves = [];\nlet lastProduct = null;\n\nif (!parsed.items.length) {\n  lines.push(parsed.clarification || 'Hangi ürün ve hangi işlem? Biraz daha açık yazar mısınız?');\n}\n\nfor (const it of parsed.items) {\n  const op = it.operation;\n  if (!it.product) {\n    lines.push('Hangi ürünü kastettiğinizi anlayamadım. Ürün adını yazar mısınız?');\n    continue;\n  }\n  const p = find(it.product);\n  if (!p) {\n    lines.push(`\"${it.product}\" ürünü bulunamadı.`);\n    continue;\n  }\n  const before = stock[p.sku];\n  lastProduct = p.product_name;\n\n  if (op === 'query') {\n    lines.push(`${p.product_name} stoğu: ${before} adet.`);\n    continue;\n  }\n\n  const q = (it.quantity === null || it.quantity === undefined) ? NaN : Number(it.quantity);\n  const valid = ['sale','add','set'].includes(op) && Number.isInteger(q) && q >= 0 && (op === 'set' || q > 0);\n  if (!valid) {\n    lines.push(`${p.product_name} için işlem veya miktar belirsiz. Örnek: \"2 tane sattım\".`);\n    continue;\n  }\n\n  let after;\n  if (op === 'sale') {\n    if (q > before) {\n      lines.push(`Yetersiz stok: ${p.product_name} stoğu ${before}, ${q} adet satılamaz. İşlem reddedildi.`);\n      continue;\n    }\n    after = before - q;\n  } else if (op === 'add') {\n    after = before + q;\n  } else {\n    after = q;\n  }\n\n  stock[p.sku] = after;\n  moves.push({\n    operation: op,\n    sku: p.sku,\n    quantity: q,\n    before,\n    after,\n    status: 'success',\n    source_text: parsed.source_text,\n    row_number: p.row_number,\n    stock: after\n  });\n  lines.push(`${p.product_name}: ${before} → ${after}`);\n}\n\nif (lastProduct) {\n  const store = $getWorkflowStaticData('global');\n  store.last_product = lastProduct;\n}\n\nconst reply = lines.join('\\n');\nconst chat_id = parsed.chat_id;\n\nif (moves.length === 0) {\n  return [{ json: { skip: true, reply, chat_id } }];\n}\nreturn moves.map(m => ({ json: { skip: false, ...m, reply, chat_id } }));"
      },

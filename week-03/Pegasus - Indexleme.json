      "name": "Gemini Embedding 768 Test"
    },
    {
      "parameters": {
        "jsCode": "\nconst embeddings = $input.all();\n\nconst chunks = $(\"Pegasus Metin Temizleme ve Chunk\").all();\n\nif (embeddings.length !== chunks.length) {\n  throw new Error(\"Chunk ve embedding sayıları eşleşmiyor.\");\n}\n\nreturn embeddings.map((item, index) => {\n  const values = item.json.embedding?.values;\n\n  if (!Array.isArray(values) || values.length !== 768) {\n    throw new Error(`Embedding ${index}: 768 boyut bulunamadı.`);\n  }\n\n  return {\n    json: {\n      content: chunks[index].json.content,\n      metadata: chunks[index].json.metadata,\n      embedding: `[${values.join(\",\")}]`\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        256
      ],
      "id": "51195185-6700-468a-833c-4fde8913be50",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst results = [];\n\nconst chunkSize = 800;\nconst overlap = 100;\n\nfor (const item of items) {\n  let text = String(item.json.content || \"\");\n\n  text = text\n    .replace(/https?:\\/\\/[^\\s]+/g, \" \")\n    .replace(/\\/(?:assets|files)\\/[^\\s\\]]+/g, \" \")\n    .replace(/\\[[^\\]]*\\]/g, \" \")\n    .replace(/\\b(?:Türkçe|English|Español|Deutsch|Italiano|Русский|Français|العربية)\\b/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  if (!text) continue;\n\n  const step = chunkSize - overlap;\n\n  for (let start = 0; start < text.length; start += step) {\n    const chunk = text.slice(start, start + chunkSize);\n\n    if (chunk.trim().length < 50) continue;\n\n    results.push({\n      json: {\n        content: chunk,\n        metadata: {\n          company: \"Pegasus Hava Yolları\",\n          source: \"Pegasus resmi web sitesi\",\n          chunk_index: results.length\n        }\n      }\n    });\n\n    if (start + chunkSize >= text.length) break;\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

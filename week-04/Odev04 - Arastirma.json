    {
      "parameters": {
        "jsCode": "const zincirIpuclari = ['franchise', 'franchising', 'branches', 'stores', 'chain', 'zincir', 'bayi', 'outlets', 'şubesi', 'şube sayısı', 'locations'];\nconst bilinenZincirler = [\"papa john\", \"domino\", \"pizza hut\", \"little caesars\", \"terra pizza\", \"pizza llc\", \"sbarro\", \"pizza pizza\", \"pizza lazza\", \"pizzabulls\", \"pizza locale\"];\n\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const metin = ((j.tavily_answer || '') + ' ' + (j.kaynaklar || '')).toLowerCase();\n  const ad = (j.title || '').toLowerCase();\n\n  const pizzaMi = /pizza|pizzac|pizzeria/i.test(j.categoryName || '');\n  const zincirMi = bilinenZincirler.some(z => ad.includes(z)) || zincirIpuclari.some(z => metin.includes(z));\n\n  const urlMatch = (j.kaynaklar || '').match(/https?:\\/\\/[^\\s|]+/);\n  const kaynak = j.website || (urlMatch ? urlMatch[0] : '');\n\n  let karar, not;\n  if (!pizzaMi) { karar = 'uygun_degil'; not = 'Kategori pizzacı değil: ' + j.categoryName; }\n  else if (zincirMi) { karar = 'zincir'; not = 'Kaynaklarda zincir/franchise/çok şube ifadesi var.'; }\n  else { karar = 'bagimsiz_adayi'; not = 'Kaynaklarda zincir ifadesi bulunmadı; resmî site/kaynak elle teyit edilmeli.'; }\n\n  out.push({ json: {\n    firma_adi: j.title,\n    bolge: 'Levent, İstanbul',\n    resmi_site: j.website || '',\n    kategori: j.categoryName,\n    adres: j.address,\n   kisa_ozet: (j.tavily_answer || j.kaynaklar || '').slice(0, 300),\n    kaynak_url: kaynak,\n    karar,\n    bagimsizlik_notu: not\n  }});\n}\nreturn out;"
      },
